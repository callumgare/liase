{
  "name": "@liase/core",
  "version": "0.0.0-version-set-when-releasing",
  "publishConfig": {
    "access": "public"
  },
  "description": "The easiest way to programmatically fetch media content details on the internet",
  "main": "dist/index.js",
  "files": ["dist/*"],
  "scripts": {
    "build": "rm -rf ./dist && tsc -p ./tsconfig.dist.json && tsc -p test/tsconfig.dist.json && tsc-alias",
    "watch": "tsc -p ./tsconfig.dist.json --watch",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "preview": "test/preview/start.sh"
  },
  "keywords": ["media"],
  "author": "Callum Gare <callum@gare.au>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callumgare/liase.git"
  },
  "dependencies": {
    "@atproto/api": "^0.13.19",
    "@refactorjs/http-proxy": "^0.2.14",
    "cacache": "^19.0.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "deepmerge": "^4.3.1",
    "dotenv-flow": "^4.1.0",
    "entities": "^4.5.0",
    "got-scraping": "^4.0.8",
    "json-stable-stringify": "^1.2.1",
    "mime-types": "^2.1.28",
    "open": "^10.1.0",
    "pluralize": "^8.0.0",
    "tsx": "^4.15.9",
    "type-fest": "^4.23.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@loopback/http-caching-proxy": "^6.0.3",
    "@tsconfig/node21": "^21.0.3",
    "@types/cacache": "^17.0.2",
    "@types/make-fetch-happen": "^10.0.4",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^22.1.0",
    "@types/pluralize": "^0.0.33",
    "copy-anything": "^4.0.2",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  }
}
