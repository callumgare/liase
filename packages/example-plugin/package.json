{
  "name": "@liase/example-plugin",
  "version": "0.0.0-version-set-when-releasing",
  "publishConfig": {
    "access": "public"
  },
  "description": "An example plugin for @liase/core",
  "main": "dist/index.js",
  "files": ["dist/*"],
  "scripts": {
    "build": "rm -rf ./dist && tsc -p ./tsconfig.dist.json && tsc-alias",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": ["media"],
  "author": "Callum Gare <callum@gare.au>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callumgare/liase.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@liase/core": "*",
    "@loopback/http-caching-proxy": "^7.0.11",
    "@refactorjs/http-proxy": "^0.2.14",
    "@tsconfig/node21": "^21.0.3",
    "@types/node": "^25.6.0",
    "copy-anything": "^4.0.2",
    "dotenv-flow": "^4.1.0",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2",
    "tsc-alias": "^1.8.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  }
}
