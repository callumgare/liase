{
  "name": "@liason/example-plugin",
  "version": "0.0.0-version-set-when-releasing",
  "description": "An example plugin for @liason/core",
  "main": "dist/index.js",
  "files": ["dist/*"],
  "scripts": {
    "build": "rm -rf ./dist && tsc && tsc-alias",
    "watch": "npm run build -- --watch",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": ["media"],
  "author": "Callum Gare <callum@gare.au>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
