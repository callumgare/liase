{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/src/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "coverage", ".turbo"],
  "extends": "@tsconfig/node21/tsconfig.json"
}
