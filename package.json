{
  "name": "liase-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.10.1",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky",
    "commit": "lint-staged && commit"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt-cli": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "turbo": "^2.5.4"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": "^9.2.0"
  }
}
